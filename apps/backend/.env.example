# Local development only. Never paste real credentials into source control.
DATABASE_URL=postgres://agentis:agentis-local-only@127.0.0.1:55432/agentis_dev
DASHBOARD_URL=http://localhost:3000
PORT=3001
# Default disables ALL execution. Privy wallet linking/auth can work read-only.
AGENTIS_EXECUTOR=disabled
AGENTIS_PLUGINS={}
# Optional local AQI fixture; configure on BOTH backend and worker. Ignored in production.
# AGENTIS_PAID_FETCH_LOCAL_ORIGINS=http://127.0.0.1:3010
# PRIVY_APP_ID=
# PRIVY_APP_SECRET=
# Privy server authorization key: base64 PKCS8 P-256, NOT a wallet private key.
# Configure one source. Keep file permissions 0600; never rotate without a wallet migration plan.
# PRIVY_AUTHORIZATION_PRIVATE_KEY=
# PRIVY_AUTHORIZATION_KEY_FILE=/absolute/path/to/server-authorization-key
# Local Anvil ONLY. Use a fresh generated test key, funded on your local node.
# AGENTIS_EXECUTOR=anvil
# ANVIL_RPC_URL=http://127.0.0.1:8545
# ANVIL_PRIVATE_KEY=
# AGENTIS_LOCAL_OWNER_TOKEN=at-least-32-random-characters
