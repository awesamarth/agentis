{
  "name": "@agentis-hq/core",
  "version": "0.3.0",
  "description": "Agentis shared types, policy engine, and constants",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./operations": {
      "types": "./dist/operations.d.ts",
      "import": "./dist/operations.js",
      "require": "./dist/operations.cjs"
    },
    "./solana-transfer": { "types": "./dist/solana-transfer.d.ts", "import": "./dist/solana-transfer.js", "require": "./dist/solana-transfer.cjs" },
    "./payment-http": { "types": "./dist/payment-http.d.ts", "import": "./dist/payment-http.js", "require": "./dist/payment-http.cjs" },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "package.json"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch"
  },
  "peerDependencies": { "@solana/web3.js": "3.0.0-rc.3", "@solana/kit": "6.8.0", "@solana-program/token": "0.11.0" },
  "peerDependenciesMeta": { "@solana/web3.js": { "optional": true }, "@solana/kit": { "optional": true }, "@solana-program/token": { "optional": true } },
  "devDependencies": {
    "@solana/web3.js": "3.0.0-rc.3", "@solana/kit": "6.8.0", "@solana-program/token": "0.11.0",
    "tsup": "^8.0.0",
    "typescript": "^5.0.0"
  },
  "dependencies": {
    "zod": "^4.5.4"
  }
}
