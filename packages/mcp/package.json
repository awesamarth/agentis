{
  "name": "@agentis-hq/mcp",
  "version": "0.2.1",
  "description": "Remote Agentis MCP tools for scoped hosted wallets, payments, balances, policies and history",
  "type": "module",
  "exports": {
    ".": { "types": "./dist/index.d.ts", "import": "./dist/index.js" },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "package.json"
  ],
  "scripts": {
    "check": "tsc --noEmit --incremental false",
    "build": "tsup",
    "build:worker": "wrangler deploy --dry-run --outdir dist-worker",
    "dev:worker": "wrangler dev"
  },
  "dependencies": {
    "@agentis-hq/core": "workspace:*",
    "@agentis-hq/sdk": "workspace:*",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "tsup": "^8.0.0",
    "typescript": "^5.0.0",
    "wrangler": "^4.0.0"
  }
}
